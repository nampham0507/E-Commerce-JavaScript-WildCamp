<%- include('../partials/header') %>

<main class="main" style="padding-top: 8rem; min-height: 80vh; max-width: 1120px; margin: 0 auto; padding-inline: 1.5rem;">
   <h2 class="home__title" style="margin-bottom: 2rem; font-family: var(--second-font);">Thanh Toán</h2>

   <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem;">
      <div style="background: #fff; border-radius: 1rem; padding: 2rem; box-shadow: 0 10px 20px rgba(0,0,0,0.05);">
         <h3 style="color: var(--title-color); margin-bottom: 1.5rem;">Thông tin giao hàng</h3>
         <form style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div>
               <label style="display: block; font-size: 0.9rem; margin-bottom: 0.5rem;">Họ và tên</label>
               <input type="text" placeholder="Nguyễn Văn A" style="width: 100%; padding: 0.75rem; border: 1px solid #ccc; border-radius: 0.5rem;">
            </div>
            <div>
               <label style="display: block; font-size: 0.9rem; margin-bottom: 0.5rem;">Số điện thoại</label>
               <input type="tel" placeholder="0901234567" style="width: 100%; padding: 0.75rem; border: 1px solid #ccc; border-radius: 0.5rem;">
            </div>
            <div>
               <label style="display: block; font-size: 0.9rem; margin-bottom: 0.5rem;">Địa chỉ giao hàng</label>
               <input type="text" placeholder="Số nhà, Tên đường, Quận/Huyện" style="width: 100%; padding: 0.75rem; border: 1px solid #ccc; border-radius: 0.5rem;">
            </div>
            <div>
               <label style="display: block; font-size: 0.9rem; margin-bottom: 0.5rem;">Ghi chú</label>
               <textarea placeholder="Lưu ý khi giao hàng..." style="width: 100%; padding: 0.75rem; border: 1px solid #ccc; border-radius: 0.5rem; height: 100px;"></textarea>
            </div>
         </form>
      </div>

      <div style="background: #fff; border-radius: 1rem; padding: 2rem; box-shadow: 0 10px 20px rgba(0,0,0,0.05); height: fit-content;">
         <h3 style="color: var(--title-color); margin-bottom: 1.5rem;">Phương thức thanh toán</h3>
         <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
               <input type="radio" name="payment" checked> COD (Thanh toán khi nhận hàng)
            </label>
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
               <input type="radio" name="payment"> Chuyển khoản ngân hàng (Qua mã QR)
            </label>
         </div>
         <button onclick="alert('Đặt hàng thành công!')" class="btn-buy" style="border: none; width: 100%; border-radius: 0.5rem; cursor: pointer;">Xác Nhận Đặt Hàng</button>
      </div>
   </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
