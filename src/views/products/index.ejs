<%- include('../partials/header') %>

<style>
  /* ── Page shell ── */
  .pl-page { padding: calc(3.5rem + 2.5rem) 1.5rem 4rem; max-width: 1260px; margin: 0 auto; }
  @media screen and (min-width: 1023px) { .pl-page { padding-top: calc(3.5rem + 2rem + 2.5rem); } }
  .pl-page-head { margin-bottom: 2rem; }
  .pl-page-title {
    font-size: 2rem; font-weight: 800; color: var(--title-color);
    font-family: var(--second-font); line-height: 1.2;
  }
  .pl-page-title span {
    display: inline-block;
    background: linear-gradient(135deg, var(--first-color), hsl(160,50%,40%));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .pl-breadcrumb { font-size: 0.82rem; color: #888; margin-bottom: 0.4rem; }
  .pl-breadcrumb a { color: var(--first-color); text-decoration: none; }
  .pl-breadcrumb a:hover { text-decoration: underline; }

  /* ── Layout ── */
  .pl-layout { display: grid; grid-template-columns: 270px 1fr; gap: 2rem; align-items: start; }
  @media (max-width: 820px) { .pl-layout { grid-template-columns: 1fr; } }

  /* ── Sidebar ── */
  .pl-sidebar {
    background: #fff; border-radius: 1.2rem;
    padding: 1.5rem; box-shadow: 0 4px 20px rgba(0,0,0,0.07);
  }
  @media screen and (min-width: 821px) {
    .pl-sidebar { position: sticky; top: 6.5rem; }
  }
  .pl-sidebar-title {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--first-color);
    margin-bottom: 1.2rem; padding-bottom: 0.6rem;
    border-bottom: 2px solid hsl(140,50%,90%);
    display: flex; align-items: center; gap: 0.4rem;
  }
  .pl-filter-group { margin-bottom: 1.4rem; }
  .pl-filter-label {
    display: block; font-size: 0.8rem; font-weight: 700;
    color: var(--title-color); margin-bottom: 0.6rem;
    text-transform: uppercase; letter-spacing: 0.05em;
  }

  /* Search */
  .pl-search-wrap { position: relative; }
  .pl-search-wrap i { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: #aaa; font-size: 1rem; }
  .pl-search-wrap input {
    width: 100%; padding: 0.6rem 0.75rem 0.6rem 2.2rem;
    border: 1.5px solid #e0e0e0; border-radius: 0.6rem;
    font-size: 0.9rem; outline: none; font-family: inherit;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }
  .pl-search-wrap input:focus { border-color: var(--first-color); }

  /* Price */
  .pl-price-row { display: flex; align-items: center; gap: 0.5rem; }
  .pl-price-row input {
    flex: 1; padding: 0.55rem 0.6rem; border: 1.5px solid #e0e0e0;
    border-radius: 0.6rem; font-size: 0.85rem; font-family: inherit;
    outline: none; transition: border-color 0.15s; min-width: 0;
    box-sizing: border-box;
  }
  .pl-price-row input:focus { border-color: var(--first-color); }
  .pl-price-row span { color: #bbb; font-size: 0.9rem; flex-shrink: 0; }
  .pl-price-hint { font-size: 0.72rem; color: #aaa; margin-top: 0.35rem; }

  /* Category radio */
  .pl-radio-list { display: flex; flex-direction: column; gap: 0.4rem; }
  .pl-radio-item {
    display: flex; align-items: center; gap: 0.55rem;
    font-size: 0.88rem; color: #444; cursor: pointer;
    padding: 0.35rem 0.5rem; border-radius: 0.5rem;
    transition: background 0.12s;
  }
  .pl-radio-item:hover { background: hsl(140,50%,96%); }
  .pl-radio-item input { accent-color: var(--first-color); width: 15px; height: 15px; cursor: pointer; }
  .pl-radio-item.active { background: hsl(140,50%,93%); font-weight: 600; color: var(--first-color); }

  /* Sidebar buttons */
  .pl-btn-apply {
    width: 100%; padding: 0.7rem;
    background: linear-gradient(135deg, var(--first-color), hsl(160,50%,35%));
    color: #fff; border: none; border-radius: 0.7rem;
    font-size: 0.9rem; font-weight: 700; cursor: pointer;
    transition: opacity 0.18s, transform 0.18s;
    margin-top: 0.4rem;
  }
  .pl-btn-apply:hover { opacity: 0.9; transform: translateY(-1px); }
  .pl-btn-reset {
    display: block; text-align: center; margin-top: 0.6rem;
    color: #888; font-size: 0.8rem; text-decoration: none;
    transition: color 0.15s;
  }
  .pl-btn-reset:hover { color: #c0392b; }

  /* ── Main area ── */
  .pl-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .pl-count-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: hsl(140,50%,94%); color: var(--first-color);
    font-size: 0.82rem; font-weight: 700; padding: 0.35rem 0.85rem;
    border-radius: 2rem; border: 1px solid hsl(140,50%,82%);
  }
  .pl-active-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pl-chip {
    display: inline-flex; align-items: center; gap: 0.35rem;
    background: #fff; border: 1px solid #ddd;
    font-size: 0.75rem; padding: 0.25rem 0.65rem;
    border-radius: 2rem; color: #555;
  }
  .pl-chip a { color: #c0392b; text-decoration: none; font-weight: 700; margin-left: 0.2rem; }

  /* Sort select */
  .pl-sort {
    padding: 0.45rem 0.75rem; border: 1.5px solid #e0e0e0;
    border-radius: 0.6rem; font-size: 0.82rem; font-family: inherit;
    outline: none; background: #fff; cursor: pointer;
    color: var(--title-color);
  }

  /* ── Product grid ── */
  .pl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1100px) { .pl-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px)  { .pl-grid { grid-template-columns: 1fr; } }

  .pl-card { position: relative; }
  .pl-card[hidden] { display: none !important; }

  .pl-card-cat {
    font-size: 0.75rem; color: #888;
    margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.25rem;
  }
  .pl-card .product-img { height: 160px; width: 100%; object-fit: contain; }
  .pl-card .product-title { font-size: 1rem; }

  /* ── Empty state ── */
  .pl-empty {
    grid-column: 1/-1; text-align: center; padding: 4rem 2rem;
    color: #aaa;
  }
  .pl-empty i { font-size: 3.5rem; display: block; margin-bottom: 1rem; color: #ccc; }
  .pl-empty p { font-size: 1.05rem; margin-bottom: 1.2rem; }
  .pl-empty a {
    display: inline-block; padding: 0.6rem 1.8rem;
    background: var(--first-color); color: #fff;
    border-radius: 2rem; text-decoration: none; font-weight: 600;
    font-size: 0.9rem; transition: opacity 0.15s;
  }
  .pl-empty a:hover { opacity: 0.88; }

  /* ── No result message inside grid ── */
  .pl-no-result {
    grid-column: 1/-1; text-align: center; padding: 3rem 1rem;
    color: #999; font-size: 1rem; display: none;
  }
  .pl-no-result i { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; color: #ddd; }
</style>

<main class="pl-page">
  <!-- Breadcrumb + Title -->
  <div class="pl-page-head">
    <p class="pl-breadcrumb"><a href="/">Trang chủ</a> / Tất cả sản phẩm</p>
    <h1 class="pl-page-title">Khám Phá <span>Tất Cả Sản Phẩm</span></h1>
  </div>

  <div class="pl-layout">
    <!-- ═══════════════ SIDEBAR ═══════════════ -->
    <aside class="pl-sidebar">
      <div class="pl-sidebar-title"><i class="ri-equalizer-2-line"></i> Bộ lọc</div>

      <form id="filterForm" method="GET" action="/products">
        <!-- Search -->
        <div class="pl-filter-group">
          <label class="pl-filter-label">Tìm theo tên</label>
          <div class="pl-search-wrap">
            <i class="ri-search-line"></i>
            <input type="text" name="q" id="searchInput"
              value="<%= q %>" placeholder="Nhập tên sản phẩm..." autocomplete="off">
          </div>
        </div>

        <!-- Price range -->
        <div class="pl-filter-group">
          <label class="pl-filter-label">Khoảng giá</label>
          <div class="pl-price-row">
            <input type="number" name="minPrice" id="minPrice"
              value="<%= minPrice %>" placeholder="Từ" min="0" step="1000">
            <span>—</span>
            <input type="number" name="maxPrice" id="maxPrice"
              value="<%= maxPrice %>" placeholder="Đến" min="0" step="1000">
          </div>
          <div class="pl-price-hint">Đơn vị: VNĐ</div>
        </div>

        <!-- Category -->
        <div class="pl-filter-group">
          <label class="pl-filter-label">Danh mục</label>
          <div class="pl-radio-list">
            <label class="pl-radio-item <%= !category ? 'active' : '' %>">
              <input type="radio" name="category" value="" <%= !category ? 'checked' : '' %>>
              <i class="ri-apps-line"></i> Tất cả
            </label>
            <% categories.forEach(cat => { %>
              <label class="pl-radio-item <%= category === cat.name ? 'active' : '' %>">
                <input type="radio" name="category" value="<%= cat.name %>" <%= category === cat.name ? 'checked' : '' %>>
                <i class="ri-price-tag-3-line"></i> <%= cat.name %>
              </label>
            <% }) %>
          </div>
        </div>

        <button type="button" class="pl-btn-reset" id="btnReset" style="width:100%;padding:0.55rem;background:#f2f4f0;color:#666;border:1.5px solid #ddd;border-radius:0.7rem;font-size:0.86rem;font-weight:600;cursor:pointer;margin-top:0.4rem;transition:background 0.15s,color 0.15s;">
          <i class="ri-refresh-line"></i> Xóa tất cả bộ lọc
        </button>
      </form>
    </aside>

    <!-- ═══════════════ MAIN ═══════════════ -->
    <div>
      <!-- Toolbar -->
      <div class="pl-toolbar">
        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
          <span class="pl-count-badge">
            <i class="ri-store-2-line"></i>
            <span id="visibleCount"><%= products.length %></span> sản phẩm
          </span>
          <span id="activeFilterTag" style="display:none;background:#fff3e6;border:1px solid #e67e22;color:#e67e22;font-size:0.75rem;font-weight:700;padding:0.25rem 0.75rem;border-radius:2rem;">
            <i class="ri-filter-3-line"></i> Đang lọc
          </span>
        </div>

        <select class="pl-sort" id="sortSelect">
          <option value="default">Mặc định</option>
          <option value="rating">Đánh giá cao nhất</option>
          <option value="price-asc">Giá: Thấp → Cao</option>
          <option value="price-desc">Giá: Cao → Thấp</option>
          <option value="name-asc">Tên A → Z</option>
        </select>
      </div>

      <!-- Grid -->
      <% if (products.length === 0) { %>
        <div class="pl-empty">
          <i class="ri-search-eye-line"></i>
          <p>Không tìm thấy sản phẩm phù hợp với bộ lọc của bạn.</p>
          <a href="/products">Xem tất cả sản phẩm</a>
        </div>
      <% } else { %>
        <div class="pl-grid" id="productGrid">
          <% products.forEach(product => { %>
            <div class="product-card pl-card"
              data-name="<%= product.name.toLowerCase() %>"
              data-price="<%= product.price %>"
              data-rating="<%= product.rating || 0 %>"
              data-category="<%= product.category %>">
              <a href="/product/<%= product._id %>" style="display:block;position:relative;">
                <img src="<%= product.image %>" alt="<%= product.name %>" class="product-img">
              </a>
              <div>
                <a href="/product/<%= product._id %>" style="text-decoration:none;">
                  <h3 class="product-title"><%= product.name %></h3>
                </a>
                <p class="pl-card-cat"><i class="ri-price-tag-3-line"></i> <%= product.category %></p>
                <% if (product.rating) { %>
                  <p style="font-size:0.85rem;color:#e67e22;margin-bottom:0.4rem;">
                    <% for(let i=1;i<=5;i++){ %><span style="color:<%= i<=Math.round(product.rating)?'#e67e22':'#ddd' %>">★</span><% } %>
                    <span style="color:#888;font-size:0.78rem;"> <%= product.rating.toFixed(1) %></span>
                  </p>
                <% } %>
                <p style="font-size:0.82rem;color:#777;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:0.4rem;"><%= product.description || '' %></p>
              </div>
              <div>
                <div class="product-price"><%= product.price.toLocaleString('vi-VN') %>đ</div>
                <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
                  <form action="/cart/add" method="POST" style="flex:1;">
                    <input type="hidden" name="productId" value="<%= product._id %>">
                    <button type="submit" class="btn-buy" style="width:100%;border:none;cursor:pointer;font-size:0.82rem;padding:0.6rem 0.4rem;">Thêm Vào Giỏ</button>
                  </form>
                  <form action="/cart/buy-now" method="POST" style="flex:1;">
                    <input type="hidden" name="productId" value="<%= product._id %>">
                    <button type="submit" style="width:100%;border:none;cursor:pointer;font-size:0.82rem;padding:0.6rem 0.4rem;border-radius:0.75rem;background:#e67e22;color:#fff;font-weight:600;">Mua Ngay</button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
          <div class="pl-no-result" id="noResult">
            <i class="ri-search-eye-line"></i>
            Không có sản phẩm nào khớp với tên "<span id="noResultTerm"></span>"
          </div>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script>
(function () {
  var searchInput   = document.getElementById('searchInput');
  var minPriceInput = document.getElementById('minPrice');
  var maxPriceInput = document.getElementById('maxPrice');
  var sortSelect    = document.getElementById('sortSelect');
  var btnReset      = document.getElementById('btnReset');
  var grid          = document.getElementById('productGrid');
  var noResult      = document.getElementById('noResult');
  var countSpan     = document.getElementById('visibleCount');
  var activeTag     = document.getElementById('activeFilterTag');

  if (!grid) return;

  var allCards = Array.from(grid.querySelectorAll('.pl-card'));

  // ── Highlight match in title ──
  function highlight(el, term) {
    var title = el.querySelector('.product-title');
    if (!title) return;
    var raw = title.dataset.raw || title.textContent;
    title.dataset.raw = raw;
    if (!term) { title.innerHTML = raw; return; }
    var re = new RegExp('(' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    title.innerHTML = raw.replace(re, '<mark style="background:hsl(140,60%,85%);border-radius:2px;padding:0 1px;">$1</mark>');
  }

  // ── Master filter ──
  function applyFilters() {
    var term   = (searchInput   ? searchInput.value.trim().toLowerCase()  : '');
    var minP   = (minPriceInput && minPriceInput.value.trim()) ? parseFloat(minPriceInput.value) : 0;
    var maxP   = (maxPriceInput && maxPriceInput.value.trim()) ? parseFloat(maxPriceInput.value) : Infinity;
    var catEl  = document.querySelector('.pl-radio-item input[type=radio]:checked');
    var activeCat = catEl ? catEl.value : '';

    var visible = 0;
    allCards.forEach(function (card) {
      var nameMatch  = !term      || (card.dataset.name || '').includes(term);
      var price      = parseFloat(card.dataset.price) || 0;
      var priceMatch = price >= minP && price <= maxP;
      var catMatch   = !activeCat || card.dataset.category === activeCat;
      var show       = nameMatch && priceMatch && catMatch;
      card.hidden    = !show;
      if (show) { visible++; highlight(card, term); }
      else { highlight(card, ''); }
    });

    if (countSpan) countSpan.textContent = visible;
    if (noResult)  noResult.style.display = (visible === 0 && allCards.length > 0) ? 'block' : 'none';

    // "Đang lọc" indicator
    var hasFilter = term || minPriceInput.value.trim() || maxPriceInput.value.trim() || activeCat;
    if (activeTag) activeTag.style.display = hasFilter ? 'inline-flex' : 'none';

    // Sync URL silently
    var params = new URLSearchParams();
    if (term)                                params.set('q', term);
    if (minPriceInput && minPriceInput.value.trim()) params.set('minPrice', minPriceInput.value.trim());
    if (maxPriceInput && maxPriceInput.value.trim()) params.set('maxPrice', maxPriceInput.value.trim());
    if (activeCat)                           params.set('category', activeCat);
    var qs = params.toString();
    history.replaceState(null, '', '/products' + (qs ? '?' + qs : ''));
  }

  // ── Debounce ──
  function debounce(fn, ms) {
    var t;
    return function () { clearTimeout(t); t = setTimeout(fn, ms); };
  }

  // ── Sort (operates on currently visible cards) ──
  function applySort() {
    if (!sortSelect) return;
    var val   = sortSelect.value;
    var cards = allCards.slice();
    cards.sort(function (a, b) {
      if (val === 'rating')     return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
      if (val === 'price-asc')  return parseFloat(a.dataset.price)  - parseFloat(b.dataset.price);
      if (val === 'price-desc') return parseFloat(b.dataset.price)  - parseFloat(a.dataset.price);
      if (val === 'name-asc')   return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'vi');
      return 0;
    });
    cards.forEach(function (c) { grid.insertBefore(c, noResult); });
  }

  // ── Listeners ──
  if (searchInput)   searchInput.addEventListener('input',  debounce(applyFilters, 220));
  if (minPriceInput) minPriceInput.addEventListener('input', debounce(applyFilters, 380));
  if (maxPriceInput) maxPriceInput.addEventListener('input', debounce(applyFilters, 380));
  if (sortSelect)    sortSelect.addEventListener('change',   applySort);

  document.querySelectorAll('.pl-radio-item input[type=radio]').forEach(function (r) {
    r.addEventListener('change', function () {
      document.querySelectorAll('.pl-radio-item').forEach(function (li) {
        li.classList.toggle('active', li.querySelector('input').checked);
      });
      applyFilters();
    });
  });

  if (btnReset) {
    btnReset.addEventListener('click', function () {
      if (searchInput)   searchInput.value   = '';
      if (minPriceInput) minPriceInput.value = '';
      if (maxPriceInput) maxPriceInput.value = '';
      var firstRadio = document.querySelector('.pl-radio-item input[type=radio][value=""]');
      if (firstRadio) { firstRadio.checked = true; }
      document.querySelectorAll('.pl-radio-item').forEach(function (li) {
        var inp = li.querySelector('input');
        li.classList.toggle('active', inp && inp.value === '');
      });
      applyFilters();
    });
  }

  // ── Init: apply filters from URL params ──
  (function initFromUrl() {
    var params = new URLSearchParams(location.search);
    if (searchInput   && params.get('q'))        searchInput.value   = params.get('q');
    if (minPriceInput && params.get('minPrice')) minPriceInput.value = params.get('minPrice');
    if (maxPriceInput && params.get('maxPrice')) maxPriceInput.value = params.get('maxPrice');
    var cat = params.get('category');
    if (cat) {
      var radio = document.querySelector('.pl-radio-item input[value="' + CSS.escape(cat) + '"]');
      if (radio) {
        radio.checked = true;
        document.querySelectorAll('.pl-radio-item').forEach(function (li) {
          li.classList.toggle('active', li.querySelector('input').checked);
        });
      }
    }
    applyFilters();
  })();
})();
</script>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
