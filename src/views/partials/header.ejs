<!DOCTYPE html>
<html lang="vi">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="icon" href="/assets/img/favicon.png" type="image/png">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.4.0/remixicon.css" crossorigin="">
   <link rel="stylesheet" href="/assets/css/styles.css">
   <title>WildCamp - Lều Trại & Đồ Dã Ngoại Cao Cấp</title>
   <style>
     /* Custom styling to match nature-friendly premium theme */
     :root {
       --first-color: hsl(140, 50%, 30%); /* Deep Forest Green */
       --gradient-color: linear-gradient(90deg, hsl(140, 40%, 15%), hsl(160, 45%, 20%));
       --title-color: hsl(140, 35%, 15%);
       --text-color: hsl(140, 20%, 20%);
       --body-color: hsl(90, 30%, 94%); /* Light nature sage/gray background */
     }
     .product-grid {
       display: grid;
       grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
       gap: 2rem;
       padding: 3rem 1.5rem;
       max-width: 1120px;
       margin: 0 auto;
     }
     .product-card {
       background: #fff;
       border-radius: 1rem;
       padding: 1.5rem;
       box-shadow: 0 10px 20px rgba(0,0,0,0.05);
       transition: transform 0.3s ease, box-shadow 0.3s ease;
       display: flex;
       flex-direction: column;
       justify-content: space-between;
     }
     .product-card:hover {
       transform: translateY(-5px);
       box-shadow: 0 15px 30px rgba(0,0,0,0.1);
     }
     .product-img {
       height: 180px;
       object-fit: contain;
       margin-bottom: 1.5rem;
     }
     .product-title {
       font-size: 1.15rem;
       color: var(--title-color);
       margin-bottom: 0.5rem;
     }
     .product-price {
       font-size: 1.3rem;
       font-weight: 700;
       color: var(--first-color);
       margin-bottom: 1rem;
     }
     .btn-buy {
       display: block;
       text-align: center;
       background: var(--gradient-color);
       color: #fff;
       padding: 0.75rem;
       border-radius: 0.5rem;
       transition: opacity 0.2s;
     }
     .btn-buy:hover {
       opacity: 0.9;
     }
     /* Additional UI refinements */
     .section-title {
       text-align: center;
       font-family: var(--second-font);
       font-size: 2rem;
       color: var(--title-color);
       margin-top: 4rem;
     }
     .nav__logo-text {
       font-weight: 700;
       color: var(--title-color);
       font-size: 1.25rem;
       display: flex;
       align-items: center;
       gap: 0.5rem;
     }
   </style>
</head>
<body>
   <!--==================== HEADER ====================-->
   <header class="header" id="header">
      <nav class="nav container">
         <a href="/" class="nav__logo-text">
            <img src="/assets/img/logo.svg" alt="logo" style="width: 32px;">
            <span>WildCamp</span>
         </a>

         <div class="nav__menu" id="nav-menu">
            <ul class="nav__list">
               <li class="nav__item"><a href="/" class="nav__link">Trang Chủ</a></li>
               <li class="nav__item"><a href="/products" class="nav__link">Sản Phẩm</a></li>
               <li class="nav__item"><a href="/cart" class="nav__link">Giỏ Hàng</a></li>
               <li class="nav__item"><a href="/checkout" class="nav__link">Thanh Toán</a></li>
               <% if (typeof locals.user !== 'undefined' && locals.user && locals.user.role === 'admin') { %>
                  <li class="nav__item"><a href="/admin" class="nav__link">Quản Trị</a></li>
               <% } %>
            </ul>

            <div class="nav__buttons">
               <% if (typeof locals.user !== 'undefined' && locals.user) { %>
                  <span style="font-size: 0.9rem; color: var(--first-color); font-weight: 600;">Chào, <%= locals.user.name %></span>
                  <a href="/auth/logout" class="nav__button-ghost" style="padding: 0.5rem 1rem; border-radius: 0.5rem;">Đăng Xuất</a>
               <% } else { %>
                  <a href="/auth/login" class="nav__button-link">Đăng Nhập</a>
                  <a href="/auth/register" class="nav__button-ghost">Đăng Ký</a>
               <% } %>
            </div>

            <!-- Close button -->
            <div class="nav__close" id="nav-close">
               <i class="ri-close-line"></i>
            </div>
         </div>

         <!-- Toggle button -->
         <div class="nav__toggle" id="nav-toggle">
            <i class="ri-menu-line"></i>
         </div>
      </nav>
   </header>
