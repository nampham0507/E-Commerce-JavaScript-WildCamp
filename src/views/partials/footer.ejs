   <!--==================== FOOTER ====================-->
   <footer style="background-color: var(--title-color); color: #fff; padding: 4rem 1.5rem 2rem; margin-top: 5rem;">
      <div style="max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 3rem;">
         <div>
            <h3 style="margin-bottom: 1.5rem; font-family: var(--second-font);">WildCamp</h3>
            <p style="opacity: 0.8; font-size: 0.9rem; line-height: 1.6;">Cung cấp các sản phẩm lều cắm trại, đồ dã ngoại chất lượng cao cho chuyến hành trình hòa mình cùng thiên nhiên của bạn.</p>
         </div>
         <div>
            <h4 style="margin-bottom: 1.5rem;">Danh Mục</h4>
            <ul style="display: flex; flex-direction: column; gap: 0.75rem; opacity: 0.8; font-size: 0.9rem;">
               <% if (typeof footerCategories !== 'undefined' && footerCategories.length > 0) { %>
                  <% footerCategories.forEach(cat => { %>
                     <li><a href="/?category=<%= encodeURIComponent(cat.name) %>" style="color: #fff;"><%= cat.name %></a></li>
                  <% }) %>
               <% } else { %>
                  <li style="opacity:0.5;">Chưa có danh mục</li>
               <% } %>
            </ul>
         </div>
         <div>
            <h4 style="margin-bottom: 1.5rem;">Liên Hệ</h4>
            <p style="opacity: 0.8; font-size: 0.9rem; line-height: 1.6; margin-bottom: 0.5rem;">Địa chỉ: Rừng Quốc Gia Ba Vì, Hà Nội</p>
            <p style="opacity: 0.8; font-size: 0.9rem; line-height: 1.6; margin-bottom: 0.5rem;">Hotline: 1900 6868</p>
            <p style="opacity: 0.8; font-size: 0.9rem; line-height: 1.6;">Email: contact@wildcamp.vn</p>
         </div>
      </div>
      <div style="border-top: 1px solid rgba(255,255,255,0.1); margin-top: 3rem; padding-top: 1.5rem; text-align: center; font-size: 0.85rem; opacity: 0.7;">
         &copy; <script>document.write(new Date().getFullYear())</script> WildCamp. All rights reserved.
      </div>
   </footer>
