<%- include('../partials/header') %>

<main class="main">
   <!--==================== HOME ====================-->
   <section class="home">
      <div class="home__container container">
         <div class="home__content">
            <div class="home__data">
               <h3 class="home__subtitle">
                  TRẢI NGHIỆM ĐỂ ĐỜI
               </h3>

               <h1 class="home__title">
                  Hòa Mình Vào <br>
                  Thiên Nhiên
               </h1>

               <p class="home__description">
                  Cắm trại bất cứ lúc nào, bất cứ nơi đâu mà không gặp rắc rối và tận hưởng cuộc phiêu lưu lý tưởng của bạn.
               </p>

               <a href="#products" class="home__button" style="border-radius: 0.75rem;">
                  Khám Phá Thiết Bị
               </a>
            </div>

            <img src="/assets/img/bird-1.svg" alt="image" class="home__bird-1">
            <img src="/assets/img/bird-2.svg" alt="image" class="home__bird-2">
         </div>

         <div class="home__images">
            <img src="/assets/img/img-4.svg" alt="image" class="home__img-4">
            <img src="/assets/img/img-3.svg" alt="image" class="home__img-3">
            <img src="/assets/img/img-2.svg" alt="image" class="home__img-2">
            <img src="/assets/img/img-1.svg" alt="image" class="home__img-1">
         </div>
      </div>
   </section>

   <!--==================== PRODUCTS ====================-->
   <section id="products" style="padding-top: 5rem;">
      <h2 class="section-title">Sản Phẩm Nổi Bật</h2>
      <p style="text-align: center; color: var(--text-color); opacity: 0.8; max-width: 600px; margin: 0.5rem auto 2rem;">Trang bị dã ngoại cao cấp cho hành trình của bạn.</p>

      <div class="product-grid featured-grid">
         <% products.forEach(product => { %>
            <div class="product-card">
               <a href="/product/<%= product._id %>" style="display:block;position:relative;">
                 <img src="<%= product.image %>" alt="<%= product.name %>" class="product-img">
                 <% if (product.rating >= 4.5) { %>
                   <span class="feat-badge">⭐ Nổi bật</span>
                 <% } %>
               </a>
               <div>
                  <a href="/product/<%= product._id %>" style="text-decoration:none;">
                    <h3 class="product-title"><%= product.name %></h3>
                  </a>
                  <p style="font-size: 0.85rem; color: #666; margin-bottom: 0.75rem; display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= product.description || '' %></p>
                  <% if (product.rating) { %>
                    <p style="font-size: 0.9rem; color: #e67e22; margin-bottom: 0.5rem;">
                      <% for(let i=1;i<=5;i++){ %><span style="color:<%= i<=Math.round(product.rating)?'#e67e22':'#ddd' %>">★</span><% } %>
                      <span style="color:#888;font-size:0.8rem;"> <%= product.rating.toFixed(1) %></span>
                    </p>
                  <% } %>
               </div>
               <div>
                  <div class="product-price"><%= typeof product.price === 'number' ? product.price.toLocaleString('vi-VN') + 'đ' : product.price %></div>
                  <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
                    <form action="/cart/add" method="POST" style="flex:1;">
                      <input type="hidden" name="productId" value="<%= product._id %>">
                      <button type="submit" class="btn-buy" style="width:100%;border:none;cursor:pointer;font-size:0.82rem;padding:0.6rem 0.4rem;">Thêm Vào Giỏ</button>
                    </form>
                    <form action="/cart/buy-now" method="POST" style="flex:1;">
                      <input type="hidden" name="productId" value="<%= product._id %>">
                      <button type="submit" style="width:100%;border:none;cursor:pointer;font-size:0.82rem;padding:0.6rem 0.4rem;border-radius:0.75rem;background:#e67e22;color:#fff;font-weight:600;">Mua Ngay</button>
                    </form>
                  </div>
               </div>
            </div>
         <% }) %>
      </div>

      <% if (totalProducts > 4) { %>
      <div style="text-align:center;margin-top:2.5rem;">
        <a href="/products" class="view-all-btn">
          Xem tất cả <%= totalProducts %> sản phẩm &rarr;
        </a>
      </div>
      <% } %>
   </section>

   <style>
     .featured-grid { grid-template-columns: repeat(4, 1fr); }
     @media (max-width: 900px) { .featured-grid { grid-template-columns: repeat(2, 1fr); } }
     @media (max-width: 500px) { .featured-grid { grid-template-columns: 1fr; } }
     .feat-badge {
       position: absolute; top: 0.6rem; left: 0.6rem;
       background: linear-gradient(135deg,#e67e22,#d35400);
       color: #fff; font-size: 0.7rem; font-weight: 700;
       padding: 0.2rem 0.55rem; border-radius: 2rem;
       box-shadow: 0 2px 6px rgba(0,0,0,0.18);
       pointer-events: none;
     }
     .view-all-btn {
       display: inline-block;
       padding: 0.85rem 2.5rem;
       background: linear-gradient(135deg, var(--first-color), var(--first-color-alt));
       color: #fff;
       font-weight: 700;
       font-size: 1rem;
       border-radius: 3rem;
       text-decoration: none;
       letter-spacing: 0.03em;
       box-shadow: 0 4px 18px rgba(44,120,87,0.25);
       transition: transform 0.18s, box-shadow 0.18s;
     }
     .view-all-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(44,120,87,0.32); }
   </style>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
