<%- include('../partials/header') %>

<style>
  .od-page {
    padding: calc(3.5rem + 2rem + 2rem) 1.5rem 4rem;
    max-width: 860px; margin: 0 auto;
  }
  @media (min-width: 1023px) { .od-page { padding-top: calc(3.5rem + 2rem + 2.5rem); } }

  /* Breadcrumb */
  .od-breadcrumb { font-size: 0.82rem; color: #888; margin-bottom: 1.2rem; }
  .od-breadcrumb a { color: var(--first-color); text-decoration: none; }
  .od-breadcrumb a:hover { text-decoration: underline; }

  /* Header */
  .od-head { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem; }
  .od-title { font-family: var(--second-font); font-size: 1.6rem; color: var(--title-color); }
  .od-code  { font-size: 0.85rem; color: #888; margin-top: 0.25rem; }

  /* Status badge */
  .od-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.4rem 1rem; border-radius: 2rem;
    font-size: 0.82rem; font-weight: 700;
  }
  .od-badge-wait  { background:#fef9e7;color:#d4ac0d;border:1px solid #f9e79f; }
  .od-badge-ok    { background:#d6eaf8;color:#1f618d;border:1px solid #aed6f1; }
  .od-badge-ship  { background:#fdebd0;color:#784212;border:1px solid #f8c471; }
  .od-badge-done  { background:#d4efdf;color:#196f3d;border:1px solid #82e0aa; }
  .od-badge-cancel{ background:#fadbd8;color:#78281f;border:1px solid #f1948a; }

  /* Progress tracker */
  .od-progress { display: flex; align-items: center; margin-bottom: 2rem; }
  .od-step { display: flex; flex-direction: column; align-items: center; flex: 1; position: relative; }
  .od-step + .od-step::before {
    content: ''; position: absolute; top: 14px; right: 50%; left: -50%;
    height: 2px; background: #e0e0e0; z-index: 0;
  }
  .od-step.done + .od-step::before { background: var(--first-color); }
  .od-step-dot {
    width: 28px; height: 28px; border-radius: 50%;
    background: #e0e0e0; color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem; font-weight: 700; z-index: 1; position: relative;
    border: 2px solid #e0e0e0;
  }
  .od-step.done .od-step-dot  { background: var(--first-color); border-color: var(--first-color); }
  .od-step.active .od-step-dot{ background: #fff; border-color: var(--first-color); color: var(--first-color); }
  .od-step.cancel .od-step-dot { background: #c0392b; border-color: #c0392b; }
  .od-step-label { font-size: 0.7rem; color: #aaa; margin-top: 0.4rem; text-align: center; white-space: nowrap; }
  .od-step.done .od-step-label, .od-step.active .od-step-label { color: var(--first-color); font-weight: 600; }
  .od-step.cancel .od-step-label { color: #c0392b; font-weight: 600; }

  /* Cards */
  .od-card {
    background: #fff; border-radius: 1rem;
    padding: 1.5rem; box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    margin-bottom: 1.25rem;
  }
  .od-card-title {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--first-color);
    margin-bottom: 1rem; padding-bottom: 0.6rem;
    border-bottom: 1.5px solid hsl(140,50%,92%);
    display: flex; align-items: center; gap: 0.4rem;
  }

  /* Info rows */
  .od-info-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 0.45rem 0; font-size: 0.9rem; border-bottom: 1px dashed #f0f0f0; }
  .od-info-row:last-child { border-bottom: none; }
  .od-info-label { color: #888; flex-shrink: 0; margin-right: 1rem; }
  .od-info-value { color: var(--title-color); font-weight: 600; text-align: right; }

  /* Items */
  .od-item { display: flex; gap: 1rem; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid #f5f5f5; }
  .od-item:last-child { border-bottom: none; }
  .od-item-img { width: 64px; height: 64px; object-fit: contain; border-radius: 0.5rem; background: #f9f9f9; flex-shrink: 0; }
  .od-item-name { font-weight: 600; font-size: 0.92rem; color: var(--title-color); }
  .od-item-meta { font-size: 0.82rem; color: #888; margin-top: 0.2rem; }
  .od-item-price { margin-left: auto; font-weight: 700; color: var(--first-color); font-size: 0.95rem; text-align: right; white-space: nowrap; }

  /* Totals */
  .od-total-row { display: flex; justify-content: space-between; font-size: 0.9rem; padding: 0.35rem 0; }
  .od-total-row.grand { border-top: 2px solid #f0f0f0; margin-top: 0.5rem; padding-top: 0.75rem; font-size: 1.1rem; font-weight: 800; color: var(--first-color); }

  /* Cancel section */
  .od-cancel-card {
    background: #fff5f5; border: 1.5px solid #f1948a;
    border-radius: 1rem; padding: 1.5rem; margin-bottom: 1.25rem;
  }
  .od-cancel-title { font-size: 0.85rem; font-weight: 700; color: #c0392b; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.4rem; }
  .od-cancel-select {
    width: 100%; padding: 0.65rem 0.9rem; border: 1.5px solid #f1948a;
    border-radius: 0.6rem; font-size: 0.9rem; font-family: inherit;
    outline: none; background: #fff; margin-bottom: 1rem;
    color: var(--title-color); cursor: pointer;
  }
  .od-cancel-select:focus { border-color: #c0392b; }
  .od-btn-cancel {
    width: 100%; padding: 0.75rem; background: #c0392b; color: #fff;
    border: none; border-radius: 0.65rem; font-size: 0.95rem; font-weight: 700;
    cursor: pointer; transition: opacity 0.18s;
  }
  .od-btn-cancel:hover { opacity: 0.88; }
  .od-cancel-note { font-size: 0.78rem; color: #c0392b; opacity: 0.7; margin-top: 0.6rem; text-align: center; }

  /* Already-cancelled reason */
  .od-cancelled-reason {
    background: #fadbd8; border-radius: 0.5rem;
    padding: 0.75rem 1rem; font-size: 0.88rem; color: #922b21;
    margin-top: 0.75rem; display: flex; align-items: flex-start; gap: 0.5rem;
  }

  .alert { padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem; font-size: 0.9rem; }
  .alert-success { background:#d4efdf;color:#155724; }
  .alert-error   { background:#fadbd8;color:#c0392b; }
</style>

<%
  var steps = ['Chờ xác nhận','Đã xác nhận','Đang giao','Đã hoàn thành'];
  var cancelled = order.status === 'Đã hủy';
  var activeIdx = steps.indexOf(order.status);

  var badgeClass = 'od-badge-wait';
  if (order.status === 'Đã xác nhận')  badgeClass = 'od-badge-ok';
  else if (order.status === 'Đang giao') badgeClass = 'od-badge-ship';
  else if (order.status === 'Đã hoàn thành') badgeClass = 'od-badge-done';
  else if (cancelled) badgeClass = 'od-badge-cancel';

  var paymentLabel = order.paymentMethod === 'VNPay' ? 'VNPay (Thẻ ngân hàng)' : 'COD (Thanh toán khi nhận)';
  var payStatusLabel = { pending:'Chờ thanh toán', paid:'Đã thanh toán', failed:'Thất bại', 'N/A':'Thanh toán khi nhận' }[order.paymentStatus] || order.paymentStatus;
  var canCancel = ['Chờ xác nhận','Đã xác nhận'].includes(order.status);
  var subtotal = order.items.reduce((s,i) => s + i.price * i.quantity, 0);
  var shipping = order.total - subtotal;
%>

<main class="od-page">
  <p class="od-breadcrumb">
    <a href="/">Trang chủ</a> /
    <a href="/my-orders">Đơn hàng của tôi</a> /
    <%= order.orderCode %>
  </p>

  <% if (flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-error"><%= flash.error %></div><% } %>

  <div class="od-head">
    <div>
      <h1 class="od-title">Chi tiết đơn hàng</h1>
      <div class="od-code">#<%= order.orderCode %> &nbsp;·&nbsp; Đặt lúc <%= new Date(order.createdAt).toLocaleDateString('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></div>
    </div>
    <span class="od-badge <%= badgeClass %>">
      <i class="ri-checkbox-circle-line"></i> <%= order.status %>
    </span>
  </div>

  <!-- Progress tracker -->
  <% if (!cancelled) { %>
  <div class="od-card" style="padding:1.25rem 1.5rem;">
    <div class="od-progress">
      <% steps.forEach(function(step, i) {
        var cls = i < activeIdx ? 'done' : (i === activeIdx ? 'active' : '');
        var icons = ['ri-file-list-3-line','ri-shield-check-line','ri-truck-line','ri-checkbox-circle-line'];
      %>
        <div class="od-step <%= cls %>">
          <div class="od-step-dot"><i class="<%= icons[i] %>"></i></div>
          <div class="od-step-label"><%= step %></div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } else { %>
  <div class="od-card" style="padding:1rem 1.5rem;background:#fff5f5;border:1.5px solid #f1948a;">
    <div style="display:flex;align-items:center;gap:0.6rem;color:#c0392b;font-weight:700;font-size:0.95rem;">
      <i class="ri-close-circle-line" style="font-size:1.3rem;"></i> Đơn hàng đã bị hủy
    </div>
    <% if (order.cancelReason) { %>
    <div class="od-cancelled-reason">
      <i class="ri-information-line"></i> Lý do: <%= order.cancelReason %>
    </div>
    <% } %>
  </div>
  <% } %>

  <!-- Customer info -->
  <div class="od-card">
    <div class="od-card-title"><i class="ri-user-line"></i> Thông tin giao hàng</div>
    <div class="od-info-row">
      <span class="od-info-label">Người nhận</span>
      <span class="od-info-value"><%= order.customer.name %></span>
    </div>
    <div class="od-info-row">
      <span class="od-info-label">Số điện thoại</span>
      <span class="od-info-value"><%= order.customer.phone %></span>
    </div>
    <div class="od-info-row">
      <span class="od-info-label">Địa chỉ</span>
      <span class="od-info-value" style="max-width:60%;"><%= order.customer.address %></span>
    </div>
    <% if (order.note) { %>
    <div class="od-info-row">
      <span class="od-info-label">Ghi chú</span>
      <span class="od-info-value" style="max-width:60%;"><%= order.note %></span>
    </div>
    <% } %>
  </div>

  <!-- Payment info -->
  <div class="od-card">
    <div class="od-card-title"><i class="ri-bank-card-line"></i> Thanh toán</div>
    <div class="od-info-row">
      <span class="od-info-label">Phương thức</span>
      <span class="od-info-value"><%= paymentLabel %></span>
    </div>
    <div class="od-info-row">
      <span class="od-info-label">Trạng thái</span>
      <span class="od-info-value"><%= payStatusLabel %></span>
    </div>
  </div>

  <!-- Items -->
  <div class="od-card">
    <div class="od-card-title"><i class="ri-shopping-bag-line"></i> Sản phẩm (<%= order.items.length %>)</div>
    <% order.items.forEach(item => { %>
      <div class="od-item">
        <img src="<%= item.image %>" alt="<%= item.name %>" class="od-item-img">
        <div>
          <div class="od-item-name"><%= item.name %></div>
          <div class="od-item-meta">Số lượng: <%= item.quantity %> &nbsp;·&nbsp; Đơn giá: <%= item.price.toLocaleString('vi-VN') %>đ</div>
        </div>
        <div class="od-item-price"><%= (item.price * item.quantity).toLocaleString('vi-VN') %>đ</div>
      </div>
    <% }) %>

    <div style="margin-top:1rem;padding-top:0.5rem;">
      <div class="od-total-row">
        <span style="color:#888;">Tạm tính</span>
        <span><%= subtotal.toLocaleString('vi-VN') %>đ</span>
      </div>
      <div class="od-total-row">
        <span style="color:#888;">Phí vận chuyển</span>
        <span><%= shipping > 0 ? shipping.toLocaleString('vi-VN') + 'đ' : 'Miễn phí' %></span>
      </div>
      <div class="od-total-row grand">
        <span>Tổng cộng</span>
        <span><%= order.total.toLocaleString('vi-VN') %>đ</span>
      </div>
    </div>
  </div>

  <!-- Cancel section -->
  <% if (canCancel) { %>
  <div class="od-cancel-card">
    <div class="od-cancel-title"><i class="ri-close-circle-line"></i> Hủy đơn hàng</div>
    <form action="/my-orders/<%= order._id %>/cancel" method="POST"
      onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?')">
      <select name="cancelReason" class="od-cancel-select" required>
        <option value="" disabled selected>-- Chọn lý do hủy --</option>
        <option value="Đặt nhầm sản phẩm">Đặt nhầm sản phẩm</option>
        <option value="Muốn đổi địa chỉ giao hàng">Muốn đổi địa chỉ giao hàng</option>
        <option value="Tìm được sản phẩm tốt hơn / rẻ hơn">Tìm được sản phẩm tốt hơn / rẻ hơn</option>
        <option value="Không có nhu cầu nữa">Không có nhu cầu nữa</option>
        <option value="Chờ quá lâu chưa được xác nhận">Chờ quá lâu chưa được xác nhận</option>
        <option value="Lý do khác">Lý do khác</option>
      </select>
      <button type="submit" class="od-btn-cancel">
        <i class="ri-close-circle-line"></i> Xác nhận hủy đơn
      </button>
    </form>
    <p class="od-cancel-note">Đơn chỉ có thể hủy khi đang ở trạng thái "Chờ xác nhận" hoặc "Đã xác nhận".</p>
  </div>
  <% } %>

  <div style="text-align:center;margin-top:1rem;">
    <a href="/my-orders" style="color:var(--first-color);text-decoration:none;font-size:0.9rem;">
      <i class="ri-arrow-left-line"></i> Quay lại danh sách đơn hàng
    </a>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
