<%- include('../partials/header') %>

<style>
  .mo-page {
    padding: calc(3.5rem + 2rem + 2rem) 1.5rem 4rem;
    max-width: 900px; margin: 0 auto;
  }
  @media (min-width: 1023px) { .mo-page { padding-top: calc(3.5rem + 2rem + 2.5rem); } }

  .mo-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem; }
  .mo-title { font-family: var(--second-font); font-size: 1.8rem; color: var(--title-color); }

  /* Status badge */
  .mo-badge {
    display: inline-block; padding: 0.25rem 0.75rem;
    border-radius: 2rem; font-size: 0.75rem; font-weight: 700;
  }
  .mo-badge-wait  { background:#fef9e7;color:#d4ac0d;border:1px solid #f9e79f; }
  .mo-badge-ok    { background:#d6eaf8;color:#1f618d;border:1px solid #aed6f1; }
  .mo-badge-ship  { background:#fdebd0;color:#784212;border:1px solid #f8c471; }
  .mo-badge-done  { background:#d4efdf;color:#196f3d;border:1px solid #82e0aa; }
  .mo-badge-cancel{ background:#fadbd8;color:#78281f;border:1px solid #f1948a; }

  /* Cards */
  .mo-list { display: flex; flex-direction: column; gap: 1rem; }
  .mo-card {
    background: #fff; border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1.5rem;
    align-items: center;
    text-decoration: none; color: inherit;
    border: 1.5px solid transparent;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .mo-card:hover { border-color: var(--first-color); box-shadow: 0 6px 24px rgba(44,120,87,0.13); }

  .mo-card-left {}
  .mo-order-code { font-size: 0.82rem; color: #888; margin-bottom: 0.3rem; }
  .mo-order-date { font-size: 0.78rem; color: #aaa; }
  .mo-order-items { font-size: 0.88rem; color: #555; margin-top: 0.4rem;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }

  .mo-card-right { text-align: right; }
  .mo-order-total { font-size: 1.15rem; font-weight: 800; color: var(--first-color); }
  .mo-order-arrow { font-size: 1.2rem; color: #ccc; margin-top: 0.5rem; }

  /* Empty */
  .mo-empty { text-align: center; padding: 4rem 2rem; color: #aaa; }
  .mo-empty i { font-size: 3.5rem; display: block; margin-bottom: 1rem; color: #ddd; }
  .mo-empty p { font-size: 1rem; margin-bottom: 1.5rem; }
  .mo-empty a {
    display: inline-block; padding: 0.65rem 2rem;
    background: var(--first-color); color: #fff;
    border-radius: 2rem; text-decoration: none; font-weight: 600;
    transition: opacity 0.15s;
  }
  .mo-empty a:hover { opacity: 0.88; }

  .alert { padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem; font-size: 0.9rem; }
  .alert-success { background:#d4efdf;color:#155724; }
  .alert-error   { background:#fadbd8;color:#c0392b; }
</style>

<main class="mo-page">
  <div class="mo-head">
    <h1 class="mo-title">Đơn hàng của tôi</h1>
    <a href="/products" style="font-size:0.88rem;color:var(--first-color);text-decoration:none;">
      <i class="ri-arrow-left-line"></i> Tiếp tục mua sắm
    </a>
  </div>

  <% if (flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-error"><%= flash.error %></div><% } %>

  <% if (orders.length === 0) { %>
    <div class="mo-empty">
      <i class="ri-shopping-bag-line"></i>
      <p>Bạn chưa có đơn hàng nào.</p>
      <a href="/products">Khám phá sản phẩm</a>
    </div>
  <% } else { %>
    <div class="mo-list">
      <% orders.forEach(order => { %>
        <%
          var badgeClass = 'mo-badge-wait';
          if (order.status === 'Đã xác nhận') badgeClass = 'mo-badge-ok';
          else if (order.status === 'Đang giao') badgeClass = 'mo-badge-ship';
          else if (order.status === 'Đã hoàn thành') badgeClass = 'mo-badge-done';
          else if (order.status === 'Đã hủy') badgeClass = 'mo-badge-cancel';
          var itemNames = order.items.map(i => i.name).join(', ');
        %>
        <a href="/my-orders/<%= order._id %>" class="mo-card">
          <div class="mo-card-left">
            <div class="mo-order-code">
              <strong>#<%= order.orderCode %></strong>
              &nbsp;·&nbsp;
              <span class="mo-badge <%= badgeClass %>"><%= order.status %></span>
            </div>
            <div class="mo-order-items"><%= itemNames %></div>
            <div class="mo-order-date"><i class="ri-calendar-line"></i> <%= new Date(order.createdAt).toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></div>
          </div>
          <div class="mo-card-right">
            <div class="mo-order-total"><%= order.total.toLocaleString('vi-VN') %>đ</div>
            <div class="mo-order-arrow"><i class="ri-arrow-right-s-line"></i></div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
