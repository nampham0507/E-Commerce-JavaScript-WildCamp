<%- include('../partials/header') %>

<style>
  .admin-container { display: flex; gap: 2rem; max-width: 1440px; margin: 0 auto; padding: 8rem 1.5rem 2rem; }
  .admin-sidebar { width: 280px; flex-shrink: 0; background: #fff; border-radius: 1rem; padding: 1.5rem; box-shadow: 0 10px 20px rgba(0,0,0,0.05); height: fit-content; }
  .admin-nav-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .admin-nav-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; color: var(--text-color); font-weight: 500; transition: all 0.3s ease; }
  .admin-nav-link:hover { background: rgba(140,200,150,0.1); color: var(--first-color); }
  .admin-nav-link.active { background: var(--gradient-color); color: #fff; }
  .admin-content { flex-grow: 1; min-width: 0; }
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 999; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 2rem 1rem; }
  .modal-overlay.open { display: flex; }
  .modal { background: #fff; border-radius: 1rem; padding: 2rem; width: 100%; max-width: 520px; box-shadow: 0 20px 40px rgba(0,0,0,0.15); margin: auto; }
  .modal h3 { font-family: var(--second-font); color: var(--title-color); margin-bottom: 1.5rem; }
  .form-group { margin-bottom: 1.1rem; }
  .form-group label { display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--title-color); }
  .form-group input, .form-group select, .form-group textarea {
    width: 100%; padding: 0.65rem 1rem; border: 1.5px solid #ddd; border-radius: 0.5rem; font-size: 0.9rem; outline: none; transition: border 0.2s; font-family: inherit;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--first-color); }
  .img-section { background: #f9f9f9; border: 1.5px dashed #ccc; border-radius: 0.75rem; padding: 1rem; margin-bottom: 0.75rem; }
  .img-section label { font-size: 0.82rem; color: #777; margin-bottom: 0.4rem; }
  .img-preview { width: 70px; height: 70px; object-fit: contain; border-radius: 0.5rem; border: 1px solid #eee; margin-top: 0.5rem; display: none; }
  .img-preview.show { display: block; }
  .btn-primary { background: var(--gradient-color); color: #fff; border: none; padding: 0.7rem 1.5rem; border-radius: 0.5rem; cursor: pointer; font-weight: 600; font-size: 0.95rem; }
  .btn-cancel { background: #eee; color: #555; border: none; padding: 0.7rem 1.2rem; border-radius: 0.5rem; cursor: pointer; font-weight: 600; font-size: 0.95rem; }
  .alert { padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem; font-size: 0.9rem; }
  .alert-success { background: #d4edda; color: #155724; }
  .alert-error { background: #fadbd8; color: #c0392b; }
  @media screen and (max-width: 768px) {
    .admin-container { flex-direction: column; padding-top: 6.5rem; }
    .admin-sidebar { width: 100%; }
    .admin-nav-list { flex-direction: row; flex-wrap: wrap; }
    .admin-nav-link { flex: 1 1 140px; justify-content: center; font-size: 0.85rem; padding: 0.5rem; }
  }

  /* ── Searchable category dropdown ── */
  .cat-combo { position: relative; }
  .cat-combo-toggle {
    width: 100%; display: flex; justify-content: space-between; align-items: center;
    padding: 0.65rem 1rem; border: 1.5px solid #ddd; border-radius: 0.5rem;
    background: #fff; font-size: 0.9rem; font-family: inherit; cursor: pointer;
    color: var(--text-color); transition: border-color 0.2s; text-align: left;
  }
  .cat-combo-toggle:focus, .cat-combo.open .cat-combo-toggle { border-color: var(--first-color); outline: none; }
  .cat-combo-toggle i { font-size: 1.1rem; color: #aaa; transition: transform 0.18s; flex-shrink: 0; }
  .cat-combo.open .cat-combo-toggle i { transform: rotate(180deg); }
  .cat-combo-label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: inherit; }
  .cat-combo-label.placeholder { color: #aaa; }
  .cat-combo-panel {
    display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0;
    background: #fff; border: 1.5px solid var(--first-color); border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12); z-index: 200; overflow: hidden;
  }
  .cat-combo.open .cat-combo-panel { display: block; }
  .cat-combo-search-row { display: flex; align-items: center; gap: 0; padding: 0.5rem; border-bottom: 1px solid #f0f0f0; }
  .cat-combo-search-row i { color: #bbb; font-size: 0.95rem; padding-left: 0.3rem; flex-shrink: 0; }
  .cat-combo-search {
    flex: 1; border: none; outline: none; font-size: 0.87rem; font-family: inherit;
    padding: 0.3rem 0.5rem; background: transparent; color: var(--text-color);
  }
  .cat-combo-list { max-height: 170px; overflow-y: auto; }
  .cat-combo-item {
    padding: 0.6rem 1rem; font-size: 0.88rem; cursor: pointer; color: #444;
    transition: background 0.1s; display: flex; align-items: center; gap: 0.5rem;
  }
  .cat-combo-item:hover { background: hsl(140,50%,95%); color: var(--first-color); }
  .cat-combo-item.cat-selected { background: hsl(140,50%,90%); color: var(--first-color); font-weight: 700; }
  .cat-combo-item.cat-hidden { display: none; }
  .cat-combo-empty { padding: 0.8rem 1rem; font-size: 0.85rem; color: #bbb; text-align: center; display: none; }
  .cat-combo-error { font-size: 0.78rem; color: #c0392b; margin-top: 0.25rem; display: none; }
</style>

<div class="admin-container">
  <%- include('partials/sidebar', { activePage: 'products' }) %>

  <main class="admin-content">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;">
      <h2 class="home__title" style="font-family:var(--second-font);margin:0;">Quản Lý Sản Phẩm</h2>
      <button onclick="openModal('modal-add')" class="btn-buy" style="border:none;border-radius:0.5rem;cursor:pointer;padding:0.6rem 1.2rem;font-size:0.9rem;">+ Thêm sản phẩm</button>
    </div>

    <% if (flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
    <% if (flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

    <div style="background:#fff;border-radius:1rem;padding:2rem;box-shadow:0 10px 20px rgba(0,0,0,0.05);overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;text-align:left;min-width:600px;">
        <thead>
          <tr style="border-bottom:2px solid #eee;">
            <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Ảnh</th>
            <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Tên sản phẩm</th>
            <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Danh mục</th>
            <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Giá (VNĐ)</th>
            <th style="padding:0.75rem 0.5rem;color:var(--title-color);text-align:center;">Tồn kho</th>
            <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (products.length === 0) { %>
            <tr><td colspan="5" style="padding:2rem;text-align:center;opacity:0.5;">Chưa có sản phẩm nào</td></tr>
          <% } %>
          <% products.forEach(p => { %>
            <tr style="border-bottom:1px solid #eee;">
              <td style="padding:0.75rem 0.5rem;">
                <% if (p.image) { %>
                  <img src="<%= p.image %>" alt="<%= p.name %>" style="width:52px;height:52px;object-fit:contain;border-radius:0.4rem;border:1px solid #eee;">
                <% } else { %>
                  <div style="width:52px;height:52px;background:#f0f0f0;border-radius:0.4rem;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:1.2rem;"><i class="ri-image-line"></i></div>
                <% } %>
              </td>
              <td style="padding:0.75rem 0.5rem;font-weight:500;max-width:180px;"><%= p.name %></td>
              <td style="padding:0.75rem 0.5rem;opacity:0.8;"><%= p.category %></td>
              <td style="padding:0.75rem 0.5rem;color:var(--first-color);font-weight:700;"><%= p.price.toLocaleString('vi-VN') %>đ</td>
              <td style="padding:0.75rem 0.5rem;text-align:center;">
                <%
                  var stockVal = p.stock || 0;
                  var stockBg = stockVal === 0 ? '#fadbd8' : stockVal <= 5 ? '#fdebd0' : '#d4efdf';
                  var stockColor = stockVal === 0 ? '#78281f' : stockVal <= 5 ? '#784212' : '#196f3d';
                  var stockLabel = stockVal === 0 ? 'Hết hàng' : stockVal <= 5 ? 'Sắp hết' : 'Còn hàng';
                %>
                <span style="background:<%= stockBg %>;color:<%= stockColor %>;padding:0.2rem 0.6rem;border-radius:2rem;font-size:0.75rem;font-weight:700;white-space:nowrap;">
                  <%= stockLabel %> (<%= stockVal %>)
                </span>
              </td>
              <td style="padding:0.75rem 0.5rem;white-space:nowrap;">
                <button onclick="openEditModal(
                  '<%= p._id %>',
                  `<%= p.name.replace(/`/g,'\\`') %>`,
                  '<%= p.category %>',
                  <%= p.price %>,
                  `<%= (p.description || '').replace(/`/g,'\\`') %>`,
                  `<%= (p.image || '').replace(/`/g,'\\`') %>`,
                  <%= p.stock || 0 %>
                )" style="background:none;border:none;color:#2980b9;cursor:pointer;font-weight:600;margin-right:1rem;">Sửa</button>
                <form action="/admin/products/delete/<%= p._id %>" method="POST" style="display:inline"
                  onsubmit="return confirm('Xác nhận xóa sản phẩm này?')">
                  <button type="submit" style="background:none;border:none;color:#c0392b;cursor:pointer;font-weight:600;">Xóa</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <%- include('partials/pagination') %>
    </div>
  </main>
</div>

<!-- Modal Thêm -->
<div class="modal-overlay" id="modal-add">
  <div class="modal">
    <h3>Thêm Sản Phẩm Mới</h3>
    <form action="/admin/products" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label>Tên sản phẩm *</label>
        <input type="text" name="name" placeholder="VD: Lều cắm trại 4 người" required>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;">
        <div class="form-group">
          <label>Danh mục *</label>
          <div class="cat-combo" id="addCatCombo">
            <input type="hidden" name="category" id="addCatVal">
            <button type="button" class="cat-combo-toggle" onclick="catToggle('addCatCombo')">
              <span class="cat-combo-label placeholder">-- Chọn danh mục --</span>
              <i class="ri-arrow-down-s-line"></i>
            </button>
            <div class="cat-combo-panel">
              <div class="cat-combo-search-row">
                <i class="ri-search-line"></i>
                <input class="cat-combo-search" type="text" placeholder="Tìm danh mục...">
              </div>
              <div class="cat-combo-list">
                <% categories.forEach(c => { %>
                  <div class="cat-combo-item" data-value="<%= c.name %>"><i class="ri-price-tag-3-line" style="color:#aaa;font-size:0.85rem;"></i><%= c.name %></div>
                <% }) %>
              </div>
              <div class="cat-combo-empty">Không tìm thấy</div>
            </div>
          </div>
          <div class="cat-combo-error" id="addCatError">Vui lòng chọn danh mục</div>
        </div>
        <div class="form-group">
          <label>Giá (VNĐ) *</label>
          <input type="number" name="price" placeholder="350000" min="0" required>
        </div>
        <div class="form-group">
          <label>Tồn kho *</label>
          <input type="number" name="stock" placeholder="0" min="0" value="0" required>
        </div>
      </div>
      <div class="form-group">
        <label>Mô tả</label>
        <textarea name="description" rows="2" placeholder="Mô tả sản phẩm..."></textarea>
      </div>

      <div style="margin-bottom:0.5rem;font-size:0.88rem;font-weight:600;color:var(--title-color);">Hình ảnh sản phẩm</div>
      <div class="img-section">
        <label>Nhập link URL hình ảnh</label>
        <input type="url" name="imageUrl" id="add-imageUrl" placeholder="https://..." oninput="previewFromUrl(this,'add-url-preview')">
        <img id="add-url-preview" class="img-preview" src="" alt="preview">
      </div>
      <div style="text-align:center;color:#aaa;font-size:0.85rem;margin:-0.25rem 0 0.5rem;">— hoặc —</div>
      <div class="img-section">
        <label>Tải lên từ máy tính</label>
        <input type="file" name="imageFile" id="add-imageFile" accept="image/*" onchange="previewFromFile(this,'add-file-preview')">
        <img id="add-file-preview" class="img-preview" src="" alt="preview">
      </div>

      <div style="display:flex;justify-content:flex-end;gap:0.5rem;margin-top:1rem;">
        <button type="button" class="btn-cancel" onclick="closeModal('modal-add')">Hủy</button>
        <button type="submit" class="btn-primary">Thêm sản phẩm</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Sửa -->
<div class="modal-overlay" id="modal-edit">
  <div class="modal">
    <h3>Chỉnh Sửa Sản Phẩm</h3>
    <form id="form-edit" action="" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="existingImage" id="edit-existingImage">
      <div class="form-group">
        <label>Tên sản phẩm *</label>
        <input type="text" name="name" id="edit-name" required>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;">
        <div class="form-group">
          <label>Danh mục *</label>
          <div class="cat-combo" id="editCatCombo">
            <input type="hidden" name="category" id="editCatVal">
            <button type="button" class="cat-combo-toggle" onclick="catToggle('editCatCombo')">
              <span class="cat-combo-label placeholder">-- Chọn danh mục --</span>
              <i class="ri-arrow-down-s-line"></i>
            </button>
            <div class="cat-combo-panel">
              <div class="cat-combo-search-row">
                <i class="ri-search-line"></i>
                <input class="cat-combo-search" type="text" placeholder="Tìm danh mục...">
              </div>
              <div class="cat-combo-list">
                <% categories.forEach(c => { %>
                  <div class="cat-combo-item" data-value="<%= c.name %>"><i class="ri-price-tag-3-line" style="color:#aaa;font-size:0.85rem;"></i><%= c.name %></div>
                <% }) %>
              </div>
              <div class="cat-combo-empty">Không tìm thấy</div>
            </div>
          </div>
          <div class="cat-combo-error" id="editCatError">Vui lòng chọn danh mục</div>
        </div>
        <div class="form-group">
          <label>Giá (VNĐ) *</label>
          <input type="number" name="price" id="edit-price" min="0" required>
        </div>
        <div class="form-group">
          <label>Tồn kho *</label>
          <input type="number" name="stock" id="edit-stock" min="0" value="0" required>
        </div>
      </div>
      <div class="form-group">
        <label>Mô tả</label>
        <textarea name="description" id="edit-description" rows="2"></textarea>
      </div>

      <div style="margin-bottom:0.5rem;font-size:0.88rem;font-weight:600;color:var(--title-color);">Hình ảnh sản phẩm</div>

      <!-- URL section — shown when current image is NOT an upload -->
      <div class="img-section" id="edit-url-section">
        <label>Link URL hình ảnh hiện tại / mới</label>
        <input type="url" name="imageUrl" id="edit-imageUrl" placeholder="https://..." oninput="previewFromUrl(this,'edit-url-preview')">
        <img id="edit-url-preview" class="img-preview" src="" alt="preview">
      </div>
      <div style="text-align:center;color:#aaa;font-size:0.85rem;margin:-0.25rem 0 0.5rem;">— hoặc —</div>
      <!-- Upload section — shown with current file preview when image IS an upload -->
      <div class="img-section" id="edit-upload-section">
        <label>Tải lên file mới từ máy tính</label>
        <!-- Current uploaded image preview -->
        <img id="edit-current-upload-preview" class="img-preview" src="" alt="ảnh hiện tại">
        <div id="edit-current-upload-label" style="font-size:0.8rem;color:#888;margin-bottom:0.4rem;display:none;">Ảnh hiện tại (không chọn file mới để giữ nguyên)</div>
        <input type="file" name="imageFile" id="edit-imageFile" accept="image/*" onchange="previewFromFile(this,'edit-file-preview')">
        <img id="edit-file-preview" class="img-preview" src="" alt="preview mới">
      </div>

      <div style="display:flex;justify-content:flex-end;gap:0.5rem;margin-top:1rem;">
        <button type="button" class="btn-cancel" onclick="closeModal('modal-edit')">Hủy</button>
        <button type="submit" class="btn-primary">Cập nhật</button>
      </div>
    </form>
  </div>
</div>

<script>
  // ═══════════════ SEARCHABLE CATEGORY COMBO ═══════════════
  function catToggle(comboId) {
    var combo = document.getElementById(comboId);
    var wasOpen = combo.classList.contains('open');
    // close all combos first
    document.querySelectorAll('.cat-combo.open').forEach(function(c) { c.classList.remove('open'); });
    if (!wasOpen) {
      combo.classList.add('open');
      var si = combo.querySelector('.cat-combo-search');
      if (si) { si.value = ''; si.focus(); catFilter(si); }
    }
  }

  function catFilter(searchInput) {
    var combo = searchInput.closest('.cat-combo');
    var term = searchInput.value.trim().toLowerCase();
    var items = combo.querySelectorAll('.cat-combo-item');
    var visible = 0;
    items.forEach(function(item) {
      var match = item.dataset.value.toLowerCase().includes(term);
      item.classList.toggle('cat-hidden', !match);
      if (match) visible++;
    });
    var empty = combo.querySelector('.cat-combo-empty');
    if (empty) empty.style.display = (visible === 0) ? 'block' : 'none';
  }

  function catSelectItem(item, comboId) {
    var combo = document.getElementById(comboId);
    var val = item.dataset.value;
    combo.querySelector('input[type=hidden]').value = val;
    var label = combo.querySelector('.cat-combo-label');
    label.textContent = val;
    label.classList.remove('placeholder');
    combo.querySelectorAll('.cat-combo-item').forEach(function(i) { i.classList.remove('cat-selected'); });
    item.classList.add('cat-selected');
    combo.classList.remove('open');
    // hide error
    var errId = comboId === 'addCatCombo' ? 'addCatError' : 'editCatError';
    document.getElementById(errId).style.display = 'none';
    combo.querySelector('.cat-combo-toggle').style.borderColor = '';
  }

  function catComboReset(comboId) {
    var combo = document.getElementById(comboId);
    combo.querySelector('input[type=hidden]').value = '';
    var label = combo.querySelector('.cat-combo-label');
    label.textContent = '-- Chọn danh mục --';
    label.classList.add('placeholder');
    combo.querySelectorAll('.cat-combo-item').forEach(function(i) { i.classList.remove('cat-selected'); });
    combo.classList.remove('open');
  }

  function catComboSet(comboId, value) {
    var combo = document.getElementById(comboId);
    var item = combo.querySelector('.cat-combo-item[data-value="' + value.replace(/"/g, '\\"') + '"]');
    if (item) catSelectItem(item, comboId);
    else catComboReset(comboId);
  }

  // init click handlers for combo items and search inputs
  document.querySelectorAll('.cat-combo').forEach(function(combo) {
    combo.addEventListener('click', function(e) { e.stopPropagation(); });
    combo.querySelectorAll('.cat-combo-item').forEach(function(item) {
      item.addEventListener('click', function() { catSelectItem(item, combo.id); });
    });
    var si = combo.querySelector('.cat-combo-search');
    if (si) si.addEventListener('input', function() { catFilter(si); });
  });

  // close on outside click
  document.addEventListener('click', function() {
    document.querySelectorAll('.cat-combo.open').forEach(function(c) { c.classList.remove('open'); });
  });

  // ═══════════════ MODAL ═══════════════
  function openModal(id) { document.getElementById(id).classList.add('open'); }

  function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    var form = document.getElementById(id).querySelector('form') || document.getElementById('form-' + id.replace('modal-', ''));
    if (form) form.reset();
    document.querySelectorAll('#' + id + ' .img-preview').forEach(function(el) { el.src = ''; el.classList.remove('show'); });
    if (id === 'modal-add') catComboReset('addCatCombo');
    if (id === 'modal-edit') catComboReset('editCatCombo');
  }

  document.querySelectorAll('.modal-overlay').forEach(function(el) {
    el.addEventListener('click', function(e) { if (e.target === this) { this.classList.remove('open'); } });
  });

  // ── Add form validation ──
  document.querySelector('#modal-add form').addEventListener('submit', function(e) {
    var val = document.getElementById('addCatVal').value;
    if (!val) {
      e.preventDefault();
      document.getElementById('addCatError').style.display = 'block';
      document.getElementById('addCatCombo').querySelector('.cat-combo-toggle').style.borderColor = '#c0392b';
    }
  });

  // ── Edit form validation ──
  document.getElementById('form-edit').addEventListener('submit', function(e) {
    var val = document.getElementById('editCatVal').value;
    if (!val) {
      e.preventDefault();
      document.getElementById('editCatError').style.display = 'block';
      document.getElementById('editCatCombo').querySelector('.cat-combo-toggle').style.borderColor = '#c0392b';
    }
  });

  function previewFromUrl(input, previewId) {
    var img = document.getElementById(previewId);
    if (input.value.trim()) { img.src = input.value.trim(); img.classList.add('show'); }
    else { img.src = ''; img.classList.remove('show'); }
  }

  function previewFromFile(input, previewId) {
    var img = document.getElementById(previewId);
    if (input.files && input.files[0]) {
      var reader = new FileReader();
      reader.onload = function(e) { img.src = e.target.result; img.classList.add('show'); };
      reader.readAsDataURL(input.files[0]);
    } else { img.src = ''; img.classList.remove('show'); }
  }

  function openEditModal(id, name, category, price, description, image, stock) {
    document.getElementById('form-edit').action = '/admin/products/edit/' + id;
    document.getElementById('edit-name').value = name;
    document.getElementById('edit-price').value = price;
    document.getElementById('edit-stock').value = stock || 0;
    document.getElementById('edit-description').value = description;
    document.getElementById('edit-existingImage').value = image;

    catComboSet('editCatCombo', category);

    // Reset image fields
    document.getElementById('edit-imageUrl').value = '';
    document.getElementById('edit-imageFile').value = '';
    ['edit-url-preview','edit-file-preview','edit-current-upload-preview'].forEach(function(pid) {
      var el = document.getElementById(pid); el.src = ''; el.classList.remove('show');
    });
    document.getElementById('edit-current-upload-label').style.display = 'none';

    var isUpload = image && image.startsWith('/assets/img/uploads/');
    if (isUpload) {
      document.getElementById('edit-current-upload-preview').src = image;
      document.getElementById('edit-current-upload-preview').classList.add('show');
      document.getElementById('edit-current-upload-label').style.display = 'block';
    } else if (image) {
      document.getElementById('edit-imageUrl').value = image;
      document.getElementById('edit-url-preview').src = image;
      document.getElementById('edit-url-preview').classList.add('show');
    }

    openModal('modal-edit');
  }

  <% if (flash.error || flash.success) { %>
  setTimeout(function() { document.querySelectorAll('.alert').forEach(function(a) { a.style.display = 'none'; }); }, 4000);
  <% } %>
</script>

