<%- include('../partials/header') %>

<style>
  .admin-container { display:flex; gap:2rem; max-width:1440px; margin:0 auto; padding:8rem 1.5rem 2rem; }
  .admin-sidebar { width:280px; flex-shrink:0; background:#fff; border-radius:1rem; padding:1.5rem; box-shadow:0 10px 20px rgba(0,0,0,0.05); height:fit-content; }
  .admin-nav-list { display:flex; flex-direction:column; gap:0.5rem; }
  .admin-nav-link { display:flex; align-items:center; gap:0.75rem; padding:0.75rem 1rem; border-radius:0.5rem; color:var(--text-color); font-weight:500; transition:all 0.3s; }
  .admin-nav-link:hover { background:rgba(140,200,150,0.1); color:var(--first-color); }
  .admin-nav-link.active { background:var(--gradient-color); color:#fff; }
  .admin-content { flex-grow:1; min-width:0; }
  @media screen and (max-width:768px) {
    .admin-container { flex-direction:column; padding-top:6.5rem; }
    .admin-sidebar { width:100%; }
    .admin-nav-list { flex-direction:row; flex-wrap:wrap; }
    .admin-nav-link { flex:1 1 140px; justify-content:center; font-size:0.85rem; padding:0.5rem; }
  }
</style>

<div class="admin-container">
  <%- include('partials/sidebar', { activePage: 'reports' }) %>

  <main class="admin-content">
    <h2 class="home__title" style="font-family:var(--second-font);margin-bottom:2rem;">Thống Kê Báo Cáo</h2>

    <div style="background:#fff;border-radius:1rem;padding:2.5rem 2rem;box-shadow:0 10px 20px rgba(0,0,0,0.05);">
      <h3 style="color:var(--title-color);margin-bottom:0.5rem;">Doanh thu 7 ngày gần đây</h3>
      <p style="font-size:0.85rem;opacity:0.6;margin-bottom:2rem;">
        Tổng: <strong><%= weeklyData.reduce((s,d) => s + d.revenue, 0).toLocaleString('vi-VN') %>đ</strong>
      </p>

      <% const maxRevenue = Math.max(...weeklyData.map(d => d.revenue), 1); %>
      <div style="display:flex;align-items:flex-end;justify-content:space-around;height:200px;border-left:2px solid #ddd;border-bottom:2px solid #ddd;padding:1rem 0.5rem 0;gap:0.5rem;">
        <% weeklyData.forEach(day => { %>
          <% const barHeight = Math.max(4, Math.round((day.revenue / maxRevenue) * 170)); %>
          <div style="display:flex;flex-direction:column;align-items:center;flex:1;gap:0.4rem;">
            <div style="font-size:0.72rem;color:var(--first-color);font-weight:600;text-align:center;">
              <% if (day.revenue > 0) { %><%= Math.round(day.revenue/1000) %>k<% } %>
            </div>
            <div title="<%= day.revenue.toLocaleString('vi-VN') %>đ"
              style="background:var(--gradient-color);width:100%;height:<%= barHeight %>px;border-radius:0.25rem 0.25rem 0 0;transition:height 0.3s;"></div>
            <span style="font-size:0.78rem;margin-top:0.25rem;"><%= day.day %></span>
          </div>
        <% }) %>
      </div>

      <% if (weeklyData.every(d => d.revenue === 0)) { %>
        <p style="text-align:center;opacity:0.5;margin-top:1rem;font-size:0.9rem;">Chưa có dữ liệu doanh thu trong 7 ngày qua</p>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
