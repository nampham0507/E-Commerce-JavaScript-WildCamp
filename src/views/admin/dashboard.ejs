<%- include('../partials/header') %>

<style>
  .admin-container { display:flex; gap:2rem; max-width:1120px; margin:0 auto; padding:8rem 1.5rem 2rem; }
  .admin-sidebar { width:280px; flex-shrink:0; background:#fff; border-radius:1rem; padding:1.5rem; box-shadow:0 10px 20px rgba(0,0,0,0.05); height:fit-content; }
  .admin-nav-list { display:flex; flex-direction:column; gap:0.5rem; }
  .admin-nav-link { display:flex; align-items:center; gap:0.75rem; padding:0.75rem 1rem; border-radius:0.5rem; color:var(--text-color); font-weight:500; transition:all 0.3s; }
  .admin-nav-link:hover { background:rgba(140,200,150,0.1); color:var(--first-color); }
  .admin-nav-link.active { background:var(--gradient-color); color:#fff; }
  .admin-content { flex-grow:1; }
  @media screen and (max-width:768px) {
    .admin-container { flex-direction:column; padding-top:6.5rem; }
    .admin-sidebar { width:100%; }
    .admin-nav-list { flex-direction:row; flex-wrap:wrap; }
    .admin-nav-link { flex:1 1 140px; justify-content:center; font-size:0.85rem; padding:0.5rem; }
  }
</style>

<div class="admin-container">
  <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

  <main class="admin-content">
    <h2 class="home__title" style="margin-bottom:2rem;font-family:var(--second-font);">Tổng quan hệ thống</h2>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem;margin-bottom:3rem;">
      <div style="background:#fff;padding:1.5rem;border-radius:0.75rem;box-shadow:0 5px 15px rgba(0,0,0,0.04);border-left:5px solid var(--first-color);">
        <span style="font-size:0.9rem;opacity:0.7;">Tổng sản phẩm</span>
        <h3 style="font-size:1.8rem;color:var(--title-color);margin-top:0.5rem;"><%= productCount %></h3>
      </div>
      <div style="background:#fff;padding:1.5rem;border-radius:0.75rem;box-shadow:0 5px 15px rgba(0,0,0,0.04);border-left:5px solid #2980b9;">
        <span style="font-size:0.9rem;opacity:0.7;">Tổng danh mục</span>
        <h3 style="font-size:1.8rem;color:var(--title-color);margin-top:0.5rem;"><%= categoryCount %></h3>
      </div>
      <div style="background:#fff;padding:1.5rem;border-radius:0.75rem;box-shadow:0 5px 15px rgba(0,0,0,0.04);border-left:5px solid #e67e22;">
        <span style="font-size:0.9rem;opacity:0.7;">Tổng đơn hàng</span>
        <h3 style="font-size:1.8rem;color:var(--title-color);margin-top:0.5rem;"><%= orderCount %></h3>
      </div>
      <div style="background:#fff;padding:1.5rem;border-radius:0.75rem;box-shadow:0 5px 15px rgba(0,0,0,0.04);border-left:5px solid #8e44ad;">
        <span style="font-size:0.9rem;opacity:0.7;">Doanh thu</span>
        <h3 style="font-size:1.4rem;color:var(--title-color);margin-top:0.5rem;"><%= totalRevenue.toLocaleString('vi-VN') %>đ</h3>
      </div>
    </div>

    <div style="background:#fff;border-radius:1rem;padding:2rem;box-shadow:0 10px 20px rgba(0,0,0,0.05);">
      <h3 style="color:var(--title-color);margin-bottom:1.25rem;font-family:var(--second-font);">Đơn hàng gần đây</h3>
      <% if (recentOrders && recentOrders.length > 0) { %>
        <table style="width:100%;border-collapse:collapse;text-align:left;">
          <thead>
            <tr style="border-bottom:2px solid #eee;">
              <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Mã đơn</th>
              <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Khách hàng</th>
              <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Tổng tiền</th>
              <th style="padding:0.75rem 0.5rem;color:var(--title-color);">Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(o => { %>
              <tr style="border-bottom:1px solid #eee;">
                <td style="padding:0.75rem 0.5rem;font-weight:600;font-size:0.85rem;color:var(--title-color);"><%= o.orderCode %></td>
                <td style="padding:0.75rem 0.5rem;"><%= o.customer.name %></td>
                <td style="padding:0.75rem 0.5rem;color:var(--first-color);font-weight:600;"><%= o.total.toLocaleString('vi-VN') %>đ</td>
                <td style="padding:0.75rem 0.5rem;">
                  <span style="padding:0.2rem 0.6rem;border-radius:1rem;font-size:0.78rem;font-weight:600;
                    <%= o.status === 'Đã hoàn thành' ? 'background:#d4efdf;color:#196f3d;' : (o.status === 'Đã hủy' ? 'background:#fadbd8;color:#78281f;' : 'background:#fcf3cf;color:#7e5109;') %>">
                    <%= o.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div style="margin-top:1rem;text-align:right;">
          <a href="/admin/orders" style="color:var(--first-color);font-size:0.9rem;font-weight:600;">Xem tất cả đơn hàng →</a>
        </div>
      <% } else { %>
        <p style="text-align:center;opacity:0.5;padding:2rem 0;">Chưa có đơn hàng nào</p>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
