<%- include('../partials/header') %>

<style>
   .admin-container {
      display: flex;
      gap: 2rem;
      max-width: 1440px;
      margin: 0 auto;
      padding: 8rem 1.5rem 2rem;
   }
   .admin-sidebar {
      width: 280px;
      flex-shrink: 0;
      background: #fff;
      border-radius: 1rem;
      padding: 1.5rem;
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
      height: fit-content;
   }
   .admin-nav-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
   }
   .admin-nav-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      color: var(--text-color);
      font-weight: 500;
      transition: all 0.3s ease;
   }
   .admin-nav-link:hover {
      background: rgba(140, 200, 150, 0.1);
      color: var(--first-color);
   }
   .admin-nav-link.active {
      background: var(--gradient-color);
      color: #fff;
   }
   .admin-content {
      flex-grow: 1;
   }

   /* Modal Styling */
   .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.4);
      align-items: center;
      justify-content: center;
   }
   .modal-content {
      background-color: #fff;
      padding: 2.5rem 2rem;
      border-radius: 1rem;
      width: 100%;
      max-width: 450px;
      box-shadow: 0 15px 30px rgba(0,0,0,0.15);
      position: relative;
   }
   .modal-close {
      position: absolute;
      top: 1rem;
      right: 1.5rem;
      font-size: 1.5rem;
      cursor: pointer;
      color: #aaa;
   }
   .modal-close:hover {
      color: #333;
   }
   .form-group {
      margin-bottom: 1.25rem;
   }
   .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
      font-weight: 500;
   }
   .form-control {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #ccc;
      border-radius: 0.5rem;
      font-size: 0.9rem;
   }

   /* Responsive layout */
   @media screen and (max-width: 768px) {
      .admin-container {
         flex-direction: column;
         padding-top: 6.5rem;
      }
      .admin-sidebar {
         width: 100%;
      }
      .admin-nav-list {
         flex-direction: row;
         flex-wrap: wrap;
      }
      .admin-nav-link {
         flex: 1 1 140px;
         justify-content: center;
         font-size: 0.85rem;
         padding: 0.5rem;
      }
   }
</style>

<div class="admin-container">
   <!-- Sidebar Partial -->
   <%- include('partials/sidebar', { activePage: 'users' }) %>

   <!-- Main content -->
   <main class="admin-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
         <h2 class="home__title" style="font-family: var(--second-font); margin: 0;">Quản Lý Người Dùng</h2>
         <button onclick="openAddModal()" class="btn-buy" style="border: none; border-radius: 0.5rem; cursor: pointer; padding: 0.6rem 1.2rem; font-size: 0.9rem;">
            + Thêm người dùng
         </button>
      </div>

      <!-- Flash Messages -->
      <% if (flash.success) { %>
         <div style="background-color: #d4efdf; color: #196f3d; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1.5rem; text-align: center; font-size: 0.9rem; font-weight: 600;">
            <%= flash.success %>
         </div>
      <% } %>
      <% if (flash.error) { %>
         <div style="background-color: #fadbd8; color: #c0392b; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1.5rem; text-align: center; font-size: 0.9rem; font-weight: 600;">
            <%= flash.error %>
         </div>
      <% } %>

      <div style="background: #fff; border-radius: 1rem; padding: 2rem; box-shadow: 0 10px 20px rgba(0,0,0,0.05); overflow-x: auto;">
         <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 600px;">
            <thead>
               <tr style="border-bottom: 2px solid #eee;">
                  <th style="padding: 1rem 0.5rem; color: var(--title-color);">Tên người dùng</th>
                  <th style="padding: 1rem 0.5rem; color: var(--title-color);">Email</th>
                  <th style="padding: 1rem 0.5rem; color: var(--title-color);">Số điện thoại</th>
                  <th style="padding: 1rem 0.5rem; color: var(--title-color);">Vai trò</th>
                  <th style="padding: 1rem 0.5rem; color: var(--title-color);">Thao tác</th>
               </tr>
            </thead>
            <tbody>
               <% users.forEach(u => { %>
                  <tr style="border-bottom: 1px solid #eee;">
                     <td style="padding: 1rem 0.5rem; font-weight: 500;"><%= u.name %></td>
                     <td style="padding: 1rem 0.5rem; opacity: 0.8;"><%= u.email %></td>
                     <td style="padding: 1rem 0.5rem; opacity: 0.8;"><%= u.phone || '—' %></td>
                     <td style="padding: 1rem 0.5rem;">
                        <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.8rem; font-weight: 600;
                           <%= u.role === 'admin' ? 'background: #fadbd8; color: #78281f;' : 'background: #d4efdf; color: #196f3d;' %>">
                           <%= u.role %>
                        </span>
                     </td>
                     <td style="padding: 1rem 0.5rem; display: flex; gap: 1rem; align-items: center;">
                        <button onclick="openEditModal('<%= u._id %>', '<%= u.name %>', '<%= u.email %>', '<%= u.phone || '' %>', '<%= u.role %>')" style="background: none; border: none; color: #2980b9; cursor: pointer; font-weight: 600;">Phân quyền / Sửa</button>
                        
                        <form action="/admin/users/delete/<%= u._id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này?');" style="margin: 0;">
                           <button type="submit" style="background: none; border: none; color: #c0392b; cursor: pointer; font-weight: 600;">Xóa</button>
                        </form>
                     </td>
                  </tr>
               <% }) %>
            </tbody>
         </table>
         <%- include('partials/pagination') %>
      </div>
   </main>
</div>

<!-- ADD USER MODAL -->
<div id="addModal" class="modal">
   <div class="modal-content">
      <span class="modal-close" onclick="closeAddModal()">&times;</span>
      <h3 style="color: var(--title-color); font-family: var(--second-font); margin-bottom: 1.5rem;">Thêm người dùng mới</h3>
      <form action="/admin/users" method="POST">
         <div class="form-group">
            <label>Họ và tên</label>
            <input type="text" name="name" required class="form-control" placeholder="Nguyễn Văn A">
         </div>
         <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" required class="form-control" placeholder="example@gmail.com">
         </div>
         <div class="form-group">
            <label>Số điện thoại</label>
            <input type="tel" name="phone" required class="form-control" placeholder="0901234567">
         </div>
         <div class="form-group">
            <label>Mật khẩu</label>
            <input type="password" name="password" required autocomplete="new-password" class="form-control" placeholder="••••••••">
         </div>
         <div class="form-group">
            <label>Vai trò</label>
            <select name="role" class="form-control">
               <option value="customer">Customer</option>
               <option value="admin">Admin</option>
            </select>
         </div>
         <button type="submit" class="btn-buy" style="border: none; width: 100%; border-radius: 0.5rem; cursor: pointer; margin-top: 1rem;">Xác Nhận Thêm</button>
      </form>
   </div>
</div>

<!-- EDIT USER MODAL -->
<div id="editModal" class="modal">
   <div class="modal-content">
      <span class="modal-close" onclick="closeEditModal()">&times;</span>
      <h3 style="color: var(--title-color); font-family: var(--second-font); margin-bottom: 1.5rem;">Cập nhật người dùng</h3>
      <form id="editForm" action="" method="POST">
         <div class="form-group">
            <label>Họ và tên</label>
            <input type="text" name="name" id="editName" required class="form-control">
         </div>
         <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" id="editEmail" required class="form-control">
         </div>
         <div class="form-group">
            <label>Số điện thoại</label>
            <input type="tel" name="phone" id="editPhone" required class="form-control" placeholder="0901234567">
         </div>
         <div class="form-group">
            <label>Vai trò</label>
            <select name="role" id="editRole" class="form-control">
               <option value="customer">Customer</option>
               <option value="admin">Admin</option>
            </select>
         </div>
         <button type="submit" class="btn-buy" style="border: none; width: 100%; border-radius: 0.5rem; cursor: pointer; margin-top: 1rem;">Lưu Thay Đổi</button>
      </form>
   </div>
</div>

<script>
   function openAddModal() {
      document.getElementById('addModal').style.display = 'flex';
   }
   function closeAddModal() {
      document.getElementById('addModal').style.display = 'none';
   }
   function openEditModal(id, name, email, phone, role) {
      document.getElementById('editForm').action = '/admin/users/edit/' + id;
      document.getElementById('editName').value = name;
      document.getElementById('editEmail').value = email;
      document.getElementById('editPhone').value = phone;
      document.getElementById('editRole').value = role;
      document.getElementById('editModal').style.display = 'flex';
   }
   function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
   }

   // Close modals if click outside content
   window.onclick = function(event) {
      const addModal = document.getElementById('addModal');
      const editModal = document.getElementById('editModal');
      if (event.target == addModal) {
         closeAddModal();
      }
      if (event.target == editModal) {
         closeEditModal();
      }
   }
</script>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
